# Source under a dedicated Castvane service account. Supply CORE_API_AUTH_PASSWORD
# through the deployment's secret manager during initial provisioning.
export CORE_BIND_ADDR=127.0.0.1:8080
export CORE_DATABASE_PATH=/var/lib/castvane/core.sqlite3
export CORE_STORAGE_DISK_DIR=/var/lib/castvane/media
export CORE_API_AUTH_ENABLE=true
export CORE_API_AUTH_DISABLE_LOCALHOST=false
export CORE_API_MAX_REQUESTS=128
export CORE_API_MAX_CONNECTIONS=1024
export CORE_API_TIMEOUT_SECONDS=15
export CORE_METRICS_ENABLE=true
export CORE_METRICS_ENABLE_PROMETHEUS=true
export CORE_LOG_LEVEL=info
export CORE_LOG_FORMAT=json
export CORE_LOG_MAX_LINES=1000

# Uncomment only when a trusted reverse proxy supplies X-Forwarded-For.
# export CORE_API_ACCESS_TRUSTED_PROXIES=127.0.0.1/32

# Optional standalone HTTPS with a service-owned 0600 private key.
# export CORE_TLS_ENABLE=true
# export CORE_TLS_ADDRESS=127.0.0.1:8443
# export CORE_TLS_CERT_FILE=/etc/castvane/fullchain.pem
# export CORE_TLS_KEY_FILE=/etc/castvane/privkey.pem
